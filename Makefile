NAME = cub3D

CC = gcc

CFLAGS = -Werror -Wextra -Wall -g -fsanitize=address

RM = rm -rf

SRCS_LINUX = 	src_linux/dlst.c\
		src_linux/draw.c\
		src_linux/free.c\
		src_linux/init.c\
		src_linux/keys.c\
		src_linux/main.c\
	    src_linux/raycaster.c\
		src_linux/raycaster2.c\
		src_linux/split1.c\
		src_linux/up_param.c\
		src_linux/utils.c\
		src_linux/utils2.c\
		src_linux/utils3.c\
		src_linux/parsing/check_map.c\
		src_linux/parsing/colors.c\
		src_linux/parsing/cp_map.c\
		src_linux/parsing/map_elem.c\
		src_linux/parsing/parsing.c\
		src_linux/parsing/parsing_utils.c\
		src_linux/parsing/parsing_utils2.c\
		src_linux/parsing/read_file.c \
		src_linux/hud.c \
		src_linux/minimap.c \
		src_linux/minimap_utils.c \

SRCS_MACOS = 	src_macos/dlst.c\
		src_macos/draw.c\
		src_macos/free.c\
		src_macos/init.c\
		src_macos/keys.c\
		src_macos/main.c\
	    src_macos/raycaster.c\
		src_macos/raycaster2.c\
		src_macos/split1.c\
		src_macos/up_param.c\
		src_macos/utils.c\
		src_macos/utils2.c\
		src_macos/utils3.c\
		src_macos/parsing/check_map.c\
		src_macos/parsing/colors.c\
		src_macos/parsing/cp_map.c\
		src_macos/parsing/map_elem.c\
		src_macos/parsing/parsing.c\
		src_macos/parsing/parsing_utils.c\
		src_macos/parsing/parsing_utils2.c\
		src_macos/parsing/read_file.c \
		src_macos/hud.c \
		src_macos/minimap.c \

UNAME_S := $(shell uname -s)

MAKE_EXT_THREAD		= @make -j -s --no-print-directory
MAKE_EXT			= @make -j1 -s --no-print-directory

ifeq ($(UNAME_S),Linux)
	LIBS 			= -Lmlx_linux -lmlx_Linux -Lminilibx-linux -Imlx_linux -lXext -lX11 -lm -lz
	MLX 			= minilibx-linux
	SRCS 			= $(SRCS_LINUX:.c=.o)
endif
ifeq ($(UNAME_S),Darwin)
	LIBS 			= -I minilibx -L minilibx_macos -lmlx -framework OpenGL -framework AppKit
	MLX 			= minilibx_macos
	SRCS 			= $(SRCS_MACOS:.c=.o)
endif

.c.o: $(SRCS)
	@printf $(green)"\r\033[KCompiling objects... "$(yellow)"<$<> ⏳ "$(reset)
	@$(CC) $(CFLAGS) -c $< -o $(<:.c=.o)

$(NAME) : ${SRCS}

	@printf $(magenta)
	@printf "\nStart build ⏳\n"
	@printf $(reset)
	@printf '\r █▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒ - 0%%\r'
	@$(MAKE_EXT_THREAD) all -C $(MLX)
	@printf '\r ███▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒ - 10%%\r'
	@$(MAKE_EXT_THREAD) bonus -C libft/libft/
	@printf '\r ███████▒▒▒▒▒▒▒▒▒▒▒▒▒▒ - 30%%\r'
	@sleep .5
	@printf $(magenta)
	@printf "Compiling cub3D🔨              \n"
	@printf $(reset)
	@printf '\r ████████████▒▒▒▒▒▒▒▒▒ - 55%%\r'
	@$(CC) $(CFLAGS) $(SRCS) libft/libft/libft.a $(LIBS) -o $(NAME)
	@printf '\r ███████████████▒▒▒▒▒▒ - 70%%\r'
	@sleep .1
	@printf '\r █████████████████▒▒▒▒ - 80%%\r'
	@sleep .1
	@printf '\r ██████████████████▒▒▒ - 85%%\r'
	@sleep .1
	@printf '\r ███████████████████▒▒ - 90%%\r'
	@sleep .1
	@printf '\r ████████████████████▒ - 95%%\r'
	@sleep .1
	@printf '\r █████████████████████ - 99%%\r'
	@sleep 0.8
	@printf $(magenta)
	@printf "Your cub3D is ready ✅           \n"
	@printf $(reset)


