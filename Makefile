fclean : clean happepe
	$(RM) $(NAME)
	make clean -C $(MLX)
	make fclean -C libft/libft

clean :
	$(RM) $(SRCS)
	make clean -C $(MLX)
	make clean -C libft/libft




re : fclean all

.PHONY : all clean fclean re
